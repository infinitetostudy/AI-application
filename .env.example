# OpenAI-compatible API. Swap BASE_URL to use Ollama, vLLM, DeepSeek, etc.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-replace-me
LLM_MODEL=gpt-4.1-mini

# Request budget
REQUEST_TIMEOUT_S=60
MAX_TOKENS=1024

# Week 02: below this confidence, needs_human is forced true
CLASSIFY_CONFIDENCE_THRESHOLD=0.7

# Week 03: keep only the tail of long tickets, plus extracted ids
CONTEXT_MAX_BODY_CHARS=800
